<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Aife.Application\Aife.Application.csproj" />
    <ProjectReference Include="..\Aife.Knowledge\Aife.Knowledge.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" />
    <PackageReference Include="Polly" />
  </ItemGroup>

  <!-- Embed the AiPreviewPage template so it's available next to the
       published binary — no dev-repo knowledge/ dependency at runtime. -->
  <ItemGroup>
    <Content Include="..\..\knowledge\referenceUiPatterns\AiPreviewPage.template.tsx"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest"
             Link="knowledge\referenceUiPatterns\AiPreviewPage.template.tsx" />
  </ItemGroup>

</Project>
