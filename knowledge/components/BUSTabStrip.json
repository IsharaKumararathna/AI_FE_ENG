{
  "componentId": "BUSTabStrip",
  "name": "BUS Tab Strip",
  "category": "navigation",
  "status": "approved",
  "description": "BUSKvalitet tab strip built on react-bootstrap Tabs/Tab. Supports count badges, colored labels (success/error/primary/warning), scrollable overflow, and dot indicators.",
  "props": [
    { "name": "tabs", "type": "array", "required": true },
    { "name": "selected", "type": "string", "required": true },
    { "name": "onSelect", "type": "function", "required": true },
    { "name": "keepTabsMounted", "type": "boolean", "required": false, "default": false },
    { "name": "renderAllContent", "type": "boolean", "required": false, "default": false }
  ],
  "tokensConsumed": ["color.primary", "color.background.surface"],
  "accessibility": { "role": "tablist", "keyboardSupport": true },
  "mapsFromHtml": ["div.bus-tab-strip-container"]
}
