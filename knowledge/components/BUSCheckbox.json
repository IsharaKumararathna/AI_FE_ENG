{
  "componentId": "BUSCheckbox",
  "name": "BUS Checkbox",
  "category": "input",
  "status": "approved",
  "description": "BUSTest custom checkbox with label. Uses native input[type=checkbox] with custom styling. Supported via BUSFormField type=Checkbox.",
  "props": [
    { "name": "label", "type": "string", "required": true },
    { "name": "name", "type": "string", "required": false },
    { "name": "checked", "type": "boolean", "required": false },
    { "name": "disabled", "type": "boolean", "required": false, "default": false },
    { "name": "onChange", "type": "function", "required": false }
  ],
  "tokensConsumed": ["color.text.primary"],
  "accessibility": { "role": "checkbox", "ariaProps": ["aria-checked"] },
  "mapsFromHtml": ["checkbox", "check", "check-box", "input[type=checkbox]"]
}
