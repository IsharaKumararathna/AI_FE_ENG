{
  "componentId": "BUSSwitch",
  "name": "BUS Switch / Toggle",
  "category": "input",
  "status": "approved",
  "description": "BUSTest toggle switch. KendoReact Switch wrapper. Supported via BUSFormField type=Switch. Sm/md/lg sizes.",
  "props": [
    { "name": "checked", "type": "boolean", "required": false },
    { "name": "onChange", "type": "function", "required": false },
    { "name": "size", "type": "string", "required": false, "enum": ["small", "medium", "large"] },
    { "name": "disabled", "type": "boolean", "required": false, "default": false }
  ],
  "tokensConsumed": ["color.primary"],
  "accessibility": { "role": "switch", "ariaProps": ["aria-checked"] },
  "mapsFromHtml": ["switch", "toggle", "toggle-switch", "div.bus-switch"]
}
